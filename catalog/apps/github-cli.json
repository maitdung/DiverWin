{
  "schemaVersion": "1.0",
  "id": "github-cli",
  "name": "GitHub CLI",
  "descriptionKey": "packages.github-cli.description",
  "category": "developer",
  "subcategory": "version-control",
  "publisher": "GitHub, Inc.",
  "officialWebsite": "https://cli.github.com/",
  "source": {
    "type": "winget",
    "packageId": "GitHub.cli",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64",
      "arm64"
    ],
    "minimumRamGB": 2,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "GitHub.cli"
    ],
    "registryDisplayNames": [
      "GitHub CLI"
    ],
    "knownPaths": [
      "%ProgramFiles%\\GitHub CLI\\gh.exe"
    ]
  },
  "dependencies": [
    "git"
  ],
  "install": {
    "mode": "silent",
    "requiresAdmin": true,
    "silent": true,
    "scope": "machine"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "developer",
      "web-developer",
      "full-stack",
      "devops",
      "ai-developer"
    ],
    "default": false,
    "conditions": []
  },
  "tags": [
    "developer",
    "version-control"
  ]
}

