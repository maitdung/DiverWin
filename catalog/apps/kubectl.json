{
  "schemaVersion": "1.0",
  "id": "kubectl",
  "name": "kubectl",
  "descriptionKey": "packages.kubectl.description",
  "category": "developer",
  "subcategory": "devops",
  "publisher": "Kubernetes Authors",
  "officialWebsite": "https://kubernetes.io/docs/tasks/tools/install-kubectl-windows/",
  "source": {
    "type": "winget",
    "packageId": "Kubernetes.kubectl",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64",
      "arm64"
    ],
    "minimumRamGB": 2,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "Kubernetes.kubectl"
    ],
    "registryDisplayNames": [
      "kubectl"
    ],
    "knownPaths": [
      "%LocalAppData%\\Microsoft\\WinGet\\Links\\kubectl.exe"
    ]
  },
  "dependencies": [],
  "install": {
    "mode": "silent",
    "requiresAdmin": false,
    "silent": true,
    "scope": "either"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "devops"
    ],
    "default": false,
    "conditions": []
  },
  "tags": [
    "developer",
    "devops"
  ]
}

