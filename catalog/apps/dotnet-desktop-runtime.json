{
  "schemaVersion": "1.0",
  "id": "dotnet-desktop-runtime",
  "name": "Microsoft .NET Windows Desktop Runtime 10.0",
  "descriptionKey": "packages.dotnet-desktop-runtime.description",
  "category": "runtime",
  "subcategory": "system-runtime",
  "publisher": "Microsoft Corporation",
  "officialWebsite": "https://dotnet.microsoft.com/download/dotnet/10.0",
  "source": {
    "type": "winget",
    "packageId": "Microsoft.DotNet.DesktopRuntime.10",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x86",
      "x64",
      "arm64"
    ],
    "minimumRamGB": 1,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "lts",
    "channel": "lts",
    "major": 10,
    "notes": ".NET 10 is the current long-term-support channel."
  },
  "detection": {
    "wingetIds": [
      "Microsoft.DotNet.DesktopRuntime.10"
    ],
    "registryDisplayNames": [],
    "registryDisplayNamePrefixes": [
      "Microsoft Windows Desktop Runtime 10."
    ],
    "knownPaths": []
  },
  "dependencies": [],
  "install": {
    "mode": "silent",
    "requiresAdmin": true,
    "silent": true,
    "scope": "machine",
    "notes": "Installs the .NET 10 Windows Desktop Runtime, which includes the base .NET Runtime and supports Windows Forms and WPF applications."
  },
  "verification": {
    "methods": [
      "winget",
      "registry"
    ],
    "minimumMatches": 1,
    "notes": "Accept either the exact WinGet identifier or an architecture-specific Microsoft Windows Desktop Runtime 10.x registry entry."
  },
  "restart": {
    "required": false,
    "behavior": "possible"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": "Microsoft .NET is distributed under the MIT license."
  },
  "recommendation": {
    "profiles": [],
    "default": false,
    "conditions": [],
    "notes": "Opt in when a Windows desktop application needs .NET 10; the .NET 10 SDK already includes this runtime."
  },
  "tags": [
    "runtime",
    "microsoft",
    "dotnet",
    "windows-desktop",
    "wpf",
    "winforms"
  ]
}
