{
  "schemaVersion": "1.0",
  "id": "obs-studio",
  "name": "OBS Studio",
  "descriptionKey": "packages.obs-studio.description",
  "category": "gaming",
  "subcategory": "streaming",
  "publisher": "OBS Project",
  "officialWebsite": "https://obsproject.com/",
  "source": {
    "type": "winget",
    "packageId": "OBSProject.OBSStudio",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64",
      "arm64"
    ],
    "minimumRamGB": 4,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "OBSProject.OBSStudio"
    ],
    "registryDisplayNames": [
      "OBS Studio"
    ],
    "knownPaths": [
      "%ProgramFiles%\\obs-studio\\bin\\64bit\\obs64.exe"
    ]
  },
  "dependencies": [
    "vcpp-x64"
  ],
  "install": {
    "mode": "silent",
    "requiresAdmin": true,
    "silent": true,
    "scope": "machine"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [],
    "default": false,
    "conditions": []
  },
  "tags": [
    "gaming",
    "streaming"
  ]
}
