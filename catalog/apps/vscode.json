{
  "schemaVersion": "1.0",
  "id": "vscode",
  "name": "Visual Studio Code",
  "descriptionKey": "packages.vscode.description",
  "category": "developer",
  "subcategory": "editor",
  "publisher": "Microsoft Corporation",
  "officialWebsite": "https://code.visualstudio.com/",
  "source": {
    "type": "winget",
    "packageId": "Microsoft.VisualStudioCode",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64",
      "arm64"
    ],
    "minimumRamGB": 2,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "Microsoft.VisualStudioCode"
    ],
    "registryDisplayNames": [
      "Visual Studio Code"
    ],
    "knownPaths": [
      "%LocalAppData%\\Programs\\Microsoft VS Code\\Code.exe",
      "%ProgramFiles%\\Microsoft VS Code\\Code.exe"
    ]
  },
  "dependencies": [],
  "install": {
    "mode": "silent",
    "requiresAdmin": false,
    "silent": true,
    "scope": "either"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "freeware",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "developer",
      "web-developer",
      "full-stack",
      "dotnet-developer",
      "python-developer",
      "devops",
      "ai-developer",
      "full-recommended"
    ],
    "default": true,
    "conditions": []
  },
  "tags": [
    "developer",
    "editor"
  ]
}

