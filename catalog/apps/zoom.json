  "riskLevel": "SAFE",
  "license": {
    "type": "freemium",
    "cost": "mixed",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "work"
    ],
    "default": false,
    "conditions": []
  },
  "tags": [
    "communication",
    "meetings"
  ]
