{
  "schemaVersion": "1.0",
  "id": "zoom",
  "name": "Zoom Workplace",
  "descriptionKey": "packages.zoom.description",
  "category": "communication",
  "subcategory": "meetings",
  "publisher": "Zoom Communications, Inc.",
  "officialWebsite": "https://zoom.us/download",
