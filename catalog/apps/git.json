{
  "schemaVersion": "1.0",
  "id": "git",
  "name": "Git",
  "descriptionKey": "packages.git.description",
  "category": "developer",
  "subcategory": "version-control",
  "publisher": "Git for Windows contributors",
  "officialWebsite": "https://gitforwindows.org/",
  "source": {
    "type": "winget",
    "packageId": "Git.Git",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64",
      "arm64"
    ],
    "minimumRamGB": 2,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "Git.Git"
    ],
    "registryDisplayNames": [
      "Git"
    ],
    "knownPaths": [
      "%ProgramFiles%\\Git\\cmd\\git.exe"
    ]
  },
  "dependencies": [],
  "install": {
    "mode": "silent",
    "requiresAdmin": true,
    "silent": true,
    "scope": "machine"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "developer",
      "web-developer",
      "full-stack",
      "dotnet-developer",
      "python-developer",
      "devops",
      "ai-developer",
      "full-recommended"
    ],
    "default": true,
    "conditions": []
  },
  "tags": [
    "developer",
    "version-control"
  ]
}

