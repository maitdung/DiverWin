{
  "schemaVersion": "1.0",
  "id": "azure-cli",
  "name": "Azure CLI",
  "descriptionKey": "packages.azure-cli.description",
  "category": "developer",
  "subcategory": "cloud",
  "publisher": "Microsoft Corporation",
  "officialWebsite": "https://learn.microsoft.com/cli/azure/install-azure-cli-windows",
  "source": {
    "type": "winget",
    "packageId": "Microsoft.AzureCLI",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64"
    ],
    "minimumRamGB": 2,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "Microsoft.AzureCLI"
    ],
    "registryDisplayNames": [
      "Azure CLI"
    ],
    "knownPaths": [
      "%ProgramFiles(x86)%\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd"
    ]
  },
  "dependencies": [],
  "install": {
    "mode": "silent",
    "requiresAdmin": true,
    "silent": true,
    "scope": "machine"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "devops"
    ],
    "default": false,
    "conditions": []
  },
  "tags": [
    "developer",
    "cloud"
  ]
}

