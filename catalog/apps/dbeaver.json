{
  "schemaVersion": "1.0",
  "id": "dbeaver",
  "name": "DBeaver Community",
  "descriptionKey": "packages.dbeaver.description",
  "category": "developer",
  "subcategory": "database",
  "publisher": "DBeaver Corp",
  "officialWebsite": "https://dbeaver.io/download/",
  "source": {
