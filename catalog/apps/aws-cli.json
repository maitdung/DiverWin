{
  "schemaVersion": "1.0",
  "id": "aws-cli",
  "name": "AWS CLI",
  "descriptionKey": "packages.aws-cli.description",
  "category": "developer",
  "subcategory": "cloud",
  "publisher": "Amazon Web Services, Inc.",
  "officialWebsite": "https://aws.amazon.com/cli/",
  "source": {
    "type": "winget",
    "packageId": "Amazon.AWSCLI",
    "sourceName": "winget"
  },
  "compatibility": {
    "os": [
      "windows10",
      "windows11"
    ],
    "minimumBuild": 17763,
    "architectures": [
      "x64",
      "arm64"
    ],
    "minimumRamGB": 2,
    "hardware": {},
    "features": {
      "internet": true
    }
  },
  "versionPolicy": {
    "strategy": "latest-compatible",
    "channel": "stable"
  },
  "detection": {
    "wingetIds": [
      "Amazon.AWSCLI"
    ],
    "registryDisplayNames": [
      "AWS CLI"
    ],
    "knownPaths": [
      "%ProgramFiles%\\Amazon\\AWSCLIV2\\aws.exe"
    ]
  },
  "dependencies": [],
  "install": {
    "mode": "silent",
    "requiresAdmin": true,
    "silent": true,
    "scope": "machine"
  },
  "verification": {
    "methods": [
      "winget",
      "registry",
      "path"
    ],
    "minimumMatches": 1,
    "notes": ""
  },
  "restart": {
    "required": false,
    "behavior": "none"
  },
  "riskLevel": "SAFE",
  "license": {
    "type": "open-source",
    "cost": "free",
    "notes": ""
  },
  "recommendation": {
    "profiles": [
      "devops"
    ],
    "default": false,
    "conditions": []
  },
  "tags": [
    "developer",
    "cloud"
  ]
}

